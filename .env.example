# 复制为 .env 或直接导出到环境变量
ANTHROPIC_API_KEY=your-api-key
# 可选：设置后启用 Tavily 联网搜索
# TAVILY_API_KEY=tvly-xxxx
# 可选：覆盖默认模型与推理强度
# AI_AGENT_MODEL=claude-opus-5
# AI_AGENT_EFFORT=high
# AI_AGENT_MAX_TURNS=20
# AI_AGENT_USE_PLANNING=1
# AI_AGENT_MAX_PLAN_STEPS=5
# AI_AGENT_MAX_REFLECTIONS=1
# QDRANT_URL=http://localhost:6333
# AI_AGENT_COLLECTION=knowledge
# AI_AGENT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# AI_AGENT_TAVILY_MAX_RESULTS=5
